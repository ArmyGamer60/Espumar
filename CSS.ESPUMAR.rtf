\f0\fs24 \cf0 :root \{\
  --primary: #1f6b75;\
  --primary-hover: #165058;\
  --dark: #1a2327;\
  --muted: #5a6a72;\
  --bg-light: #f8fafb;\
  --border: #e2e8f0;\
\}\
\
* \{ box-sizing: border-box; margin: 0; padding: 0; \}\
body \{ font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: var(--dark); background: #fff; line-height: 1.6; \}\
.container \{ max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; \}\
\
/* Navegaci\'f3n */\
.header \{ border-bottom: 1px solid var(--border); position: sticky; top: 0; background: rgba(255,255,255,0.95); backdrop-filter: blur(6px); z-index: 50; \}\
.nav-wrap \{ display: flex; justify-content: space-between; align-items: center; height: 68px; \}\
.logo \{ font-weight: 800; letter-spacing: 2px; color: var(--primary); text-decoration: none; font-size: 1.25rem; \}\
.nav a \{ margin-left: 1.25rem; text-decoration: none; color: var(--dark); font-size: 0.95rem; \}\
\
/* Botones */\
.btn \{ display: inline-block; padding: 0.65rem 1.4rem; border-radius: 8px; font-weight: 600; text-decoration: none; transition: 0.2s ease; font-size: 0.95rem; \}\
.btn-sm \{ padding: 0.4rem 0.9rem; font-size: 0.85rem; background: var(--primary); color: #fff !important; \}\
.btn-primary \{ background: var(--primary); color: #fff; \}\
.btn-primary:hover \{ background: var(--primary-hover); \}\
.btn-outline \{ border: 1px solid var(--border); color: var(--dark); \}\
\
/* Hero */\
.hero \{ padding: 4.5rem 0; \}\
.hero-grid \{ display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.5rem; align-items: center; \}\
.pill \{ display: inline-block; padding: 0.25rem 0.75rem; background: rgba(31,107,117,0.1); color: var(--primary); font-size: 0.8rem; font-weight: 700; border-radius: 20px; margin-bottom: 0.8rem; \}\
.hero h1 \{ font-size: 2.4rem; line-height: 1.2; margin-bottom: 1rem; \}\
.hero p \{ color: var(--muted); margin-bottom: 1.75rem; \}\
.actions \{ display: flex; gap: 1rem; \}\
.visual-placeholder \{ height: 320px; background: var(--bg-light); border: 2px dashed var(--border); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--muted); font-weight: 600; \}\
\
/* Filtros y Tarjetas */\
.section \{ padding: 4rem 0; background: var(--bg-light); \}\
.section-title \{ text-align: center; margin-bottom: 2rem; \}\
.filters \{ display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 2.5rem; flex-wrap: wrap; \}\
.filter-btn \{ border: 1px solid var(--border); background: #fff; padding: 0.45rem 1.1rem; border-radius: 20px; cursor: pointer; font-size: 0.88rem; transition: 0.2s ease; \}\
.filter-btn.active, .filter-btn:hover \{ background: var(--primary); color: #fff; border-color: var(--primary); \}\
\
.cards-grid \{ display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.5rem; \}\
.card \{ background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; display: flex; flex-direction: column; transition: transform 0.2s ease; \}\
.card:hover \{ transform: translateY(-3px); \}\
.card.hidden \{ display: none; \}\
.card .badge \{ align-self: flex-start; color: var(--primary); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem; \}\
.card h3 \{ margin-bottom: 0.5rem; font-size: 1.15rem; \}\
.card p \{ color: var(--muted); font-size: 0.9rem; margin-bottom: 1.25rem; flex-grow: 1; \}\
.card-action \{ color: var(--primary); text-decoration: none; font-weight: 600; font-size: 0.9rem; \}\
\
.footer \{ border-top: 1px solid var(--border); padding: 2rem 0; background: #fff; text-align: center; font-size: 0.85rem; color: var(--muted); \}\
\
@media (max-width: 768px) \{\
  .hero-grid \{ grid-template-columns: 1fr; \}\
  .actions \{ flex-direction: column; \}\
\}}